{
  "name": "windscout",
  "version": "0.6.4",
  "description": "Find which Windscribe locations and protocols work from your network, ranked by latency (unofficial)",
  "type": "module",
  "bin": {
    "windscout": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc && node -e \"fs.chmodSync('dist/cli.js', 0o755)\"",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "keywords": [
    "windscribe",
    "vpn",
    "wireguard",
    "stealth",
    "cli",
    "censorship",
    "firewall",
    "unblock",
    "server-finder",
    "docker"
  ],
  "author": "Dier Cohen <i.am.dier.cohen@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diercohen/windscout.git"
  },
  "homepage": "https://github.com/Diercohen/windscout#readme",
  "bugs": "https://github.com/Diercohen/windscout/issues",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
